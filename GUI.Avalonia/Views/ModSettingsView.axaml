<UserControl
    x:Class="RSMods.Views.ModSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:views="clr-namespace:RSMods.Views"
    xmlns:settings="clr-namespace:RSMods.Core.Settings;assembly=GUI.Core"
    xmlns:conv="clr-namespace:RSMods.Converters"
    x:DataType="vm:ModSettingsViewModel">

    <UserControl.Styles>
        <!-- A hidden setting hides its whole row, so the panel doesn't space an empty one. -->
        <Style Selector="ItemsControl.fields > ContentPresenter" x:DataType="settings:SettingFieldViewModel">
            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
        </Style>
        <Style Selector="Grid.field > NumericUpDown, Grid.field > ComboBox, Grid.field > TextBox">
            <Setter Property="Width" Value="260" />
        </Style>
        <Style Selector="ListBox.mods > ListBoxItem" x:DataType="vm:ModItemViewModel">
            <Setter Property="AutomationProperties.Name" Value="{Binding Entry.Title}" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="6,1" />
        </Style>
    </UserControl.Styles>

    <!-- The mod list and the selected mod's pane each scroll on their own; the page itself never scrolls, so there is
         never a list scrolling inside another scrolling area. -->
    <Grid Margin="32,28" RowDefinitions="Auto,*" RowSpacing="18" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h1" Text="Mod Settings" />
            <TextBlock
                Grid.Column="1" VerticalAlignment="Bottom"
                FontSize="12" Opacity="0.7"
                Text="{Binding StatusMessage}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="18">
            <!-- Mods -->
            <Border Classes="card" Padding="0,12,0,6">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBox
                        Margin="12,0"
                        Watermark="Search mods"
                        AutomationProperties.Name="Search mods"
                        Text="{Binding Filter}" />
                    <ListBox
                        Grid.Row="1"
                        Classes="mods"
                        Background="Transparent"
                        AutomationProperties.Name="Mods"
                        ItemsSource="{Binding Mods}"
                        SelectedItem="{Binding SelectedMod}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModItemViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Entry.Title}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Padding="0"
                                        IsVisible="{Binding Entry.HasToggle}"
                                        AutomationProperties.Name="{Binding Entry.Title, StringFormat='Enable {0}'}"
                                        IsChecked="{Binding Entry.Toggle.Value, FallbackValue=False}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- The selected mod -->
            <Border Grid.Column="1" Classes="card" Padding="0">
                <ScrollViewer x:Name="DetailScroller" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20" Spacing="18" IsVisible="{Binding SelectedMod, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="h2" TextWrapping="Wrap" Text="{Binding SelectedMod.Entry.Title, FallbackValue=''}" />
                                <TextBlock
                                    Classes="hint" FontSize="13"
                                    IsVisible="{Binding SelectedMod.Entry.HasDescription, FallbackValue=False}"
                                    Text="{Binding SelectedMod.Entry.Description, FallbackValue=''}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1" VerticalAlignment="Top"
                                OnContent="On" OffContent="Off"
                                AutomationProperties.Name="{Binding SelectedMod.Entry.Title, StringFormat='Enable {0}', FallbackValue='Enable'}"
                                IsVisible="{Binding SelectedMod.Entry.HasToggle, FallbackValue=False}"
                                IsChecked="{Binding SelectedMod.Entry.Toggle.Value, FallbackValue=False}" />
                        </Grid>

                        <TextBlock
                            Classes="hint"
                            IsVisible="{Binding SelectedMod.Entry.ShowEnableHint, FallbackValue=False}"
                            Text="Turn this mod on to change its settings." />

                        <!-- Settings -->
                        <ItemsControl Classes="fields" ItemsSource="{Binding SelectedMod.Entry.Fields, FallbackValue={x:Null}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <!-- Bool / Toggle -->
                                <DataTemplate DataType="settings:BoolSettingFieldViewModel">
                                    <CheckBox
                                        Margin="{Binding IsNested, Converter={x:Static conv:BoolToIndentConverter.Instance}}"
                                        AutomationProperties.Name="{Binding Label}"
                                        IsChecked="{Binding Value}">
                                        <StackPanel Spacing="2">
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                            <TextBlock Classes="hint" IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>

                                <!-- Numeric -->
                                <DataTemplate DataType="settings:NumericSettingFieldViewModel">
                                    <Grid Classes="field" ColumnDefinitions="*,Auto"
                                          Margin="{Binding IsNested, Converter={x:Static conv:BoolToIndentConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                            <TextBlock Classes="hint" IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
                                        </StackPanel>
                                        <NumericUpDown
                                            AutomationProperties.Name="{Binding Label}"
                                            Minimum="{Binding Minimum}"
                                            Maximum="{Binding Maximum}"
                                            Increment="{Binding Increment}"
                                            FormatString="{Binding FormatString}"
                                            Value="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>

                                <!-- Enum / Choices; a font list shows each font in itself. -->
                                <DataTemplate DataType="settings:EnumSettingFieldViewModel">
                                    <Grid Classes="field" ColumnDefinitions="*,Auto"
                                          Margin="{Binding IsNested, Converter={x:Static conv:BoolToIndentConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                            <TextBlock Classes="hint" IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
                                        </StackPanel>
                                        <ComboBox
                                            IsVisible="{Binding !IsFontChoice}"
                                            AutomationProperties.Name="{Binding Label}"
                                            ItemsSource="{Binding Choices}"
                                            SelectedItem="{Binding SelectedValue}" />
                                        <ComboBox
                                            IsVisible="{Binding IsFontChoice}"
                                            AutomationProperties.Name="{Binding Label}"
                                            ItemsSource="{Binding Choices}"
                                            SelectedItem="{Binding SelectedValue}">
                                            <ComboBox.ItemTemplate>
                                                <!-- The name stays readable (symbol fonts would hide it); the sample shows the font. -->
                                                <DataTemplate x:DataType="x:String">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            FontFamily="{Binding Converter={x:Static conv:FontFamilyConverter.Instance}}"
                                                            Text="Abc 123" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>

                                <!-- String / Text -->
                                <DataTemplate DataType="settings:StringSettingFieldViewModel">
                                    <Grid Classes="field" ColumnDefinitions="*,Auto"
                                          Margin="{Binding IsNested, Converter={x:Static conv:BoolToIndentConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Label}" />
                                            <TextBlock Classes="hint" IsVisible="{Binding HasHint}" Text="{Binding Hint}" />
                                        </StackPanel>
                                        <TextBox AutomationProperties.Name="{Binding Label}" Text="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>

                                <!-- Custom editor launcher -->
                                <DataTemplate DataType="settings:CustomEditorFieldViewModel">
                                    <Button
                                        HorizontalAlignment="Left"
                                        Margin="{Binding IsNested, Converter={x:Static conv:BoolToIndentConverter.Instance}}"
                                        Content="{Binding ButtonText}"
                                        Command="{Binding OpenEditorCommand}" />
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>

                        <!-- On-screen text: the chosen font at the chosen size, under the font picker. -->
                        <Border
                            Padding="16,12"
                            CornerRadius="6"
                            Background="{DynamicResource SubtleFillBrush}"
                            IsVisible="{Binding SelectedMod.IsOnScreenText, FallbackValue=False}">
                            <TextBlock
                                FontFamily="{Binding OnScreenFontPreview}"
                                FontSize="{Binding OnScreenFontSizePreview}"
                                TextWrapping="Wrap"
                                Text="ABCabc 0123 — the quick brown fox" />
                        </Border>

                        <!-- Secondary monitor: capture where the game should start. -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Grid.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="SelectedMod.IsSecondaryMonitor" FallbackValue="False" />
                                    <Binding Path="ShowSecondaryMonitor" />
                                </MultiBinding>
                            </Grid.IsVisible>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SecondaryMonitorPositionText}" />
                                <TextBlock Classes="hint" Text="Drag this window to the monitor and spot you want the game to start on, then capture its position." />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="Use this window's position"
                                Command="{Binding CaptureSecondaryMonitorPositionCommand}"
                                CommandParameter="{Binding $parent[Window]}" />
                        </Grid>

                        <!-- Guitar Speak note mappings -->
                        <views:GuitarSpeakControl>
                            <views:GuitarSpeakControl.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="SelectedMod.IsGuitarSpeak" FallbackValue="False" />
                                    <Binding Path="ShowGuitarSpeak" />
                                </MultiBinding>
                            </views:GuitarSpeakControl.IsVisible>
                        </views:GuitarSpeakControl>

                        <!-- Key binds -->
                        <StackPanel Spacing="10" IsVisible="{Binding SelectedMod.HasKeybinds, FallbackValue=False}">
                            <Border Classes="divider" />
                            <StackPanel Spacing="2">
                                <TextBlock Classes="h3" Text="Key binds" />
                                <TextBlock Classes="hint" Text="Click a bind, then press a key (or the middle / a side mouse button). Keys Rocksmith uses ask for confirmation." />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedMod.Keybinds, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeybindRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,6">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                            <views:KeyCaptureButton
                                                Grid.Column="1"
                                                Width="220"
                                                HorizontalContentAlignment="Center"
                                                AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} key'}"
                                                Classes.accent="{Binding IsCapturing}"
                                                Content="{Binding ButtonText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

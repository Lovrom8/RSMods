<UserControl
    x:Class="RSMods.Views.ModSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:settings="clr-namespace:RSMods.Core.Settings;assembly=GUI.Core"
    xmlns:conv="clr-namespace:RSMods.Converters"
    x:DataType="vm:ModSettingsViewModel">

    <UserControl.Resources>
        <conv:BoolToIndentConverter x:Key="BoolToIndent" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="36" MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Mod Settings" />
            <TextBlock
                FontSize="13"
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="Mod settings driven by the DLL schema manifest. Editing a value marks the page unsaved; Save writes back to RSMods.ini while preserving comments and unknown entries." />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding SaveCommand}" Content="Save" />
                <Button Command="{Binding RevertCommand}" Content="Revert" />
                <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding StatusMessage}" />
            </StackPanel>

            <!-- Dynamic Schema Groups -->
            <ItemsControl ItemsSource="{Binding SettingGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="settings:SettingGroupViewModel">
                        <Border
                            Margin="0,0,0,18"
                            Padding="18"
                            BorderBrush="#4A5361"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsVisible="{Binding HasVisibleFields}">
                            <StackPanel Spacing="12">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.Styles>
                                        <Style Selector="ItemsControl > ContentPresenter" x:DataType="settings:SettingFieldViewModel">
                                            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.DataTemplates>
                                        <!-- Bool / Toggle -->
                                        <DataTemplate DataType="settings:BoolSettingFieldViewModel">
                                            <CheckBox
                                                Margin="{Binding IsNested, Converter={StaticResource BoolToIndent}}"
                                                Content="{Binding Label}"
                                                IsChecked="{Binding Value}"
                                                ToolTip.Tip="{Binding Hint}" />
                                        </DataTemplate>

                                        <!-- Numeric -->
                                        <DataTemplate DataType="settings:NumericSettingFieldViewModel">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="{Binding IsNested, Converter={StaticResource BoolToIndent}}">
                                                <TextBlock Width="220" VerticalAlignment="Center" Text="{Binding Label}" ToolTip.Tip="{Binding Hint}" />
                                                <NumericUpDown
                                                    MinWidth="200"
                                                    HorizontalAlignment="Left"
                                                    Minimum="{Binding Minimum}"
                                                    Maximum="{Binding Maximum}"
                                                    Increment="{Binding Increment}"
                                                    FormatString="{Binding FormatString}"
                                                    Value="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Enum / Choices -->
                                        <DataTemplate DataType="settings:EnumSettingFieldViewModel">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="{Binding IsNested, Converter={StaticResource BoolToIndent}}">
                                                <TextBlock Width="220" VerticalAlignment="Center" Text="{Binding Label}" ToolTip.Tip="{Binding Hint}" />
                                                <ComboBox
                                                    MinWidth="200"
                                                    ItemsSource="{Binding Choices}"
                                                    SelectedItem="{Binding SelectedValue}" />
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- String / Text -->
                                        <DataTemplate DataType="settings:StringSettingFieldViewModel">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="{Binding IsNested, Converter={StaticResource BoolToIndent}}">
                                                <TextBlock Width="220" VerticalAlignment="Center" Text="{Binding Label}" ToolTip.Tip="{Binding Hint}" />
                                                <TextBox
                                                    MinWidth="200"
                                                    Text="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>

                                        <!-- Custom Editor Launcher -->
                                        <DataTemplate DataType="settings:CustomEditorFieldViewModel">
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="{Binding IsNested, Converter={StaticResource BoolToIndent}}">
                                                <Button
                                                    Content="{Binding ButtonText}"
                                                    Command="{Binding OpenEditorCommand}"
                                                    ToolTip.Tip="{Binding Hint}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- On-screen text font preview helper -->
            <Border Padding="18" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="On-screen text font preview" />
                    <Border Padding="12" Background="#181B20" CornerRadius="4">
                        <TextBlock
                            FontFamily="{Binding OnScreenFontPreview}"
                            FontSize="22"
                            Text="ABCabc 0123 — the quick brown fox" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Secondary monitor position capture helper -->
            <Border
                Padding="18"
                BorderBrush="#4A5361"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding ShowSecondaryMonitor}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Secondary Monitor Position Helper" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="Drag this window onto the monitor and spot you want the game to start on, then capture its position." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            Content="Set to current window position"
                            Command="{Binding CaptureSecondaryMonitorPositionCommand}"
                            CommandParameter="{Binding $parent[Window]}" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding SecondaryMonitorPositionText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Guitar Speak -->
            <Border
                Padding="18"
                BorderBrush="#4A5361"
                BorderThickness="1"
                CornerRadius="8"
                IsVisible="{Binding ShowGuitarSpeak}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Guitar Speak Note Mappings" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="Map guitar notes to key presses so you can drive menus with your guitar. Pick a note and octave, then assign it to the selected key press." />

                    <!-- Mapping editor -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Opacity="0.7" Text="Note" />
                            <ComboBox
                                MinWidth="80"
                                ItemsSource="{Binding GuitarSpeakNotes}"
                                SelectedItem="{Binding SelectedGuitarSpeakNote}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Opacity="0.7" Text="Octave" />
                            <ComboBox
                                MinWidth="80"
                                ItemsSource="{Binding GuitarSpeakOctaves}"
                                SelectedItem="{Binding SelectedGuitarSpeakOctave}" />
                        </StackPanel>
                        <Button
                            VerticalAlignment="Bottom"
                            Content="Assign to selected key"
                            Command="{Binding AssignGuitarSpeakCommand}" />
                    </StackPanel>

                    <!-- Key-press mappings -->
                    <TextBlock FontSize="12" Opacity="0.7" Text="Key presses" />
                    <ListBox
                        MaxHeight="230"
                        ItemsSource="{Binding GuitarSpeakMappings}"
                        SelectedItem="{Binding SelectedGuitarSpeakMapping}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GuitarSpeakRowViewModel">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1" Opacity="0.8" Text="{Binding NoteDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button
                        HorizontalAlignment="Left"
                        Content="Clear selected mapping"
                        Command="{Binding ClearGuitarSpeakCommand}" />
                </StackPanel>
            </Border>

            <!-- Keybindings -->
            <Border Padding="18" BorderBrush="#4A5361" BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Keybindings" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="Select a bind, then press a key (or middle / side mouse button) in the capture box below its list to assign it. Keys Rocksmith reserves will ask for confirmation." />

                    <Grid ColumnDefinitions="*,16,*">
                        <!-- Mods -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Mods" />
                            <ListBox
                                MaxHeight="280"
                                ItemsSource="{Binding ModKeybinds}"
                                SelectedItem="{Binding SelectedModKeybind}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeybindRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1" Opacity="0.8" Text="{Binding KeyDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox
                                x:Name="ModCaptureBox"
                                IsReadOnly="True"
                                Watermark="Press a key to assign…" />
                        </StackPanel>

                        <!-- Audio -->
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Audio" />
                            <ListBox
                                MaxHeight="280"
                                ItemsSource="{Binding AudioKeybinds}"
                                SelectedItem="{Binding SelectedAudioKeybind}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeybindRowViewModel">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1" Opacity="0.8" Text="{Binding KeyDisplay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox
                                x:Name="AudioCaptureBox"
                                IsReadOnly="True"
                                Watermark="Press a key to assign…" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

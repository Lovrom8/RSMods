<UserControl
    x:Class="RSMods.Views.GuitarSpeakControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    x:DataType="vm:ModSettingsViewModel">

    <StackPanel Spacing="10">
        <StackPanel Spacing="2">
            <TextBlock Classes="h3" Text="Note mappings" />
            <TextBlock Classes="hint" Text="Pick the note and octave that press each key, so you can drive menus with your guitar." />
        </StackPanel>

        <!-- Every mapping at once, in rows rather than a scrolling list, so the pane's own scroll is the only one. -->
        <ItemsControl ItemsSource="{Binding GuitarSpeakMappings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GuitarSpeakRowViewModel">
                    <Grid ColumnDefinitions="*,96,84,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                        <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                        <ComboBox
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Note"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} note'}"
                            ItemsSource="{x:Static vm:GuitarSpeakRowViewModel.Notes}"
                            SelectedItem="{Binding Note}" />
                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Octave"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} octave'}"
                            ItemsSource="{x:Static vm:GuitarSpeakRowViewModel.Octaves}"
                            SelectedItem="{Binding Octave}" />
                        <Button
                            Grid.Column="3"
                            Content="Clear"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat='Clear {0}'}"
                            Command="{Binding ClearCommand}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

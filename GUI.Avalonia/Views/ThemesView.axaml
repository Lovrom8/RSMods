<UserControl
    x:Class="RSMods.Views.ThemesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:conv="clr-namespace:RSMods.Converters"
    x:DataType="vm:ThemesViewModel">

    <UserControl.Resources>
        <!-- One accent choice: a preview swatch over its name. -->
        <DataTemplate x:Key="AccentTemplate" x:DataType="vm:AccentPreset">
            <StackPanel Width="52" Spacing="6">
                <Border
                    Height="32"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4"
                    Background="{Binding SwatchHex, Converter={x:Static conv:HexToBrushConverter.Instance}}" />
                <TextBlock HorizontalAlignment="Center" FontSize="12" Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Appearance" />
            <TextBlock
                Classes="pageintro"
                Text="Choose how the configurator itself looks. Changes apply immediately and are saved to RSMods.ini. (This themes the app, not the game.)" />

            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Classes="card" MaxWidth="{StaticResource PageProseMaxWidth}" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    <Grid Classes="action" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="actionname" Text="Theme" />
                            <TextBlock Classes="hint" Text="System follows your Windows light/dark setting." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            Width="160" VerticalAlignment="Center"
                            AutomationProperties.Name="Theme"
                            ItemsSource="{Binding ThemeVariants}"
                            SelectedItem="{Binding SelectedThemeVariant}" />
                    </Grid>

                    <Border Classes="divider" />

                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="actionname" Text="Accent colour" />
                            <TextBlock Classes="hint" Text="Tints buttons, selections, and highlights across the app." />
                        </StackPanel>
                        <ListBox
                            Margin="-12,0,0,0"
                            Background="Transparent"
                            AutomationProperties.Name="Accent colour"
                            ItemsSource="{Binding AccentPresets}"
                            SelectedItem="{Binding SelectedAccent}"
                            ItemTemplate="{StaticResource AccentTemplate}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window
    x:Class="RSMods.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:views="clr-namespace:RSMods.Views"
    x:DataType="vm:MainWindowViewModel"
    Title="RSMods"
    Width="1080"
    Height="720"
    MinWidth="800"
    MinHeight="520"
    WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:StatusViewModel">
            <views:StatusView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModSettingsViewModel">
            <views:ModSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ColorsViewModel">
            <views:ColorsView />
        </DataTemplate>
        <DataTemplate DataType="vm:RocksmithSettingsViewModel">
            <views:RocksmithSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AsioSettingsViewModel">
            <views:AsioSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ThemesViewModel">
            <views:ThemesView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="24,18" Background="{DynamicResource ShellHeaderBrush}">
            <StackPanel Spacing="3">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="RSMods" />
                <TextBlock Opacity="0.7" Text="Avalonia migration shell" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <Border Padding="18" Background="{DynamicResource ShellNavBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Margin="4,0,0,8" FontWeight="SemiBold" Text="Sections" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowStatusCommand}" Content="Status" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowModSettingsCommand}" Content="Mod Settings" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowColorsCommand}" Content="Custom Colors" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowRocksmithCommand}" Content="Rocksmith" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowAsioCommand}" Content="RS_ASIO" />
                    <Button HorizontalContentAlignment="Left" Command="{Binding ShowThemesCommand}" Content="Appearance" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>

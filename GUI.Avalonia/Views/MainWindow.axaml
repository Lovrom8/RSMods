<Window
    x:Class="RSMods.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:views="clr-namespace:RSMods.Views"
    xmlns:conv="clr-namespace:RSMods.Converters"
    x:DataType="vm:MainWindowViewModel"
    Title="RSMods"
    Width="1360"
    Height="860"
    MinWidth="1000"
    MinHeight="600"
    WindowStartupLocation="CenterScreen">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:StatusViewModel">
            <views:StatusView />
        </DataTemplate>
        <DataTemplate DataType="vm:ModSettingsViewModel">
            <views:ModSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ColorsViewModel">
            <views:ColorsView />
        </DataTemplate>
        <DataTemplate DataType="vm:RocksmithSettingsViewModel">
            <views:RocksmithSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:AsioSettingsViewModel">
            <views:AsioSettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ThemesViewModel">
            <views:ThemesView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProfilesViewModel">
            <views:ProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:SoundPacksViewModel">
            <views:SoundPacksView />
        </DataTemplate>
        <DataTemplate DataType="vm:SetAndForgetViewModel">
            <views:SetAndForgetView />
        </DataTemplate>
        <DataTemplate DataType="vm:TwitchViewModel">
            <views:TwitchView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="Auto,*">
        <!-- Header: accent app-mark + title, with a thin accent rule underneath to anchor the chrome. -->
        <Border Background="{DynamicResource ShellHeaderBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,2">
                <StackPanel Margin="22,16" Orientation="Horizontal" Spacing="14">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="Bold" Foreground="White" Text="RS" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="RSMods" />
                        <TextBlock Opacity="0.65" FontSize="12" Text="Rocksmith 2014 Mod Configurator" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Height="2" Background="{DynamicResource AccentBrush}" Opacity="0.85" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="228,*">
            <Border Background="{DynamicResource ShellNavBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,16" Spacing="4">
                        <Button Classes="nav" Command="{Binding ShowStatusCommand}" Content="Home"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Status}" />

                        <TextBlock Classes="eyebrow" Margin="12,14,0,4" Text="CONFIGURATION" />
                        <Button Classes="nav" Command="{Binding ShowModSettingsCommand}" Content="Mod Settings"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=ModSettings}" />
                        <Button Classes="nav" Command="{Binding ShowColorsCommand}" Content="Custom Colors"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Colors}" />
                        <Button Classes="nav" Command="{Binding ShowRocksmithCommand}" Content="Rocksmith"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Rocksmith}" />
                        <Button Classes="nav" Command="{Binding ShowProfilesCommand}" Content="Profiles"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Profiles}" />
                        <Button Classes="nav" Command="{Binding ShowSetAndForgetCommand}" Content="Set &amp; Forget"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=SetAndForget}" />

                        <TextBlock Classes="eyebrow" Margin="12,14,0,4" Text="AUDIO" />
                        <Button Classes="nav" Command="{Binding ShowAsioCommand}" Content="RS_ASIO"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Asio}" />
                        <Button Classes="nav" Command="{Binding ShowSoundPacksCommand}" Content="SoundPacks"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=SoundPacks}" />

                        <TextBlock Classes="eyebrow" Margin="12,14,0,4" Text="INTEGRATIONS" />
                        <Button Classes="nav" Command="{Binding ShowTwitchCommand}" Content="Twitch"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Twitch}" />

                        <TextBlock Classes="eyebrow" Margin="12,14,0,4" Text="APP" />
                        <Button Classes="nav" Command="{Binding ShowThemesCommand}" Content="Appearance"
                                Classes.active="{Binding ActiveSection, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Themes}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>

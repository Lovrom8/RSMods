<UserControl
    x:Class="RSMods.Views.SetAndForgetView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RSMods.Converters"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:views="clr-namespace:RSMods.Views"
    x:DataType="vm:SetAndForgetViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.fieldlabel">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Tuning headings in the Custom Tuning list can't be picked; they only group the songs under them. -->
        <Style Selector="ComboBox.customtunings > ComboBoxItem" x:DataType="vm:CustomTuningRow">
            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
        </Style>
        <Style Selector="ComboBox.customtunings > ComboBoxItem:disabled">
            <Setter Property="Padding" Value="11,12,11,2" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Set &amp; Forget" />

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowIndeterminateBusy}">
                <ProgressBar Width="120" IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding StatusMessage}" />
            </StackPanel>

            <TextBlock
                FontSize="12"
                Opacity="0.7"
                IsVisible="{Binding !IsBusy}"
                Text="{Binding StatusMessage}" />

            <!-- Quick actions: the one-click mods and the tools that undo them. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Grid.Column="0" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="One-click mods" />
                            <TextBlock
                                Classes="hint"
                                Text="Each one changes the game's current files, so applied mods combine. Removing them takes Restore original files or a Steam verify." />
                        </StackPanel>

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Turn it up to eleven" />
                                <TextBlock Classes="hint" Text="Installs a Wwise init bank with increased volume." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Apply Turn it up to eleven"
                                Command="{Binding IncreaseVolumeCommand}"
                                Content="Apply" />
                        </Grid>
                        <Border Classes="divider" />

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Exit Game menu option" />
                                <TextBlock Classes="hint" Text="Replaces the Uplay button in the main menu with EXIT GAME." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Apply Exit Game menu option"
                                Command="{Binding AddExitGameCommand}"
                                Content="Apply" />
                        </Grid>
                        <Border Classes="divider" />

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Direct Connect mode" />
                                <TextBlock Classes="hint" Text="Unlocks the hidden input mode: Microphone Mode with tone simulation on." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Apply Direct Connect mode"
                                Command="{Binding AddDirectConnectCommand}"
                                Content="Apply" />
                        </Grid>
                        <Border Classes="divider" />

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Fast Load" />
                                <TextBlock Classes="hint" Text="Skips the intro screens. Checks your drive first: HDDs and unknown drives ask for confirmation, NVMe can opt into the fastest variant." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Apply Fast Load"
                                Command="{Binding ApplyFastLoadCommand}"
                                Content="Apply" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Game files" />
                            <TextBlock
                                Classes="hint"
                                Text="The backup holds the game's files from before the first mod here was applied." />
                        </StackPanel>

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Restore original files" />
                                <TextBlock Classes="hint" Text="Removes every mod applied here by putting the backup back." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Restore original files"
                                Command="{Binding RestoreDefaultsCommand}"
                                Content="Restore" />
                        </Grid>
                        <Border Classes="divider" />

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Import existing settings" />
                                <TextBlock Classes="hint" Text="Loads the tunings already in the game into the editor below." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Import existing settings"
                                Command="{Binding ImportExistingSettingsCommand}"
                                Content="Import" />
                        </Grid>
                        <Border Classes="divider" />

                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="actionname" Text="Remove temporary folders" />
                                <TextBlock Classes="hint" Text="Frees space left over from older versions. The game's files are not changed." />
                            </StackPanel>
                            <Button
                                AutomationProperties.Name="Remove temporary folders"
                                Command="{Binding RemoveTempFoldersCommand}"
                                Content="Remove" />
                        </Grid>

                        <Border Classes="warning" Padding="12">
                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Last resort: verify with Steam" />
                                    <TextBlock
                                        Classes="hint"
                                        Text="If restoring the backup doesn't fix the game, Steam redownloads the modified files." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Verify game files"
                                    Command="{Binding ResetCacheCommand}"
                                    Content="Verify" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" IsEnabled="{Binding !IsBusy}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Custom tunings" />
                            <TextBlock
                                Classes="hint"
                                MaxWidth="{StaticResource PageProseMaxWidth}"
                                HorizontalAlignment="Left"
                                Text="Pick a tuning to edit it, or &lt;New&gt; to create one. Offsets are semitones from standard tuning. Add, Save and Remove change the local tuning list; Add to game puts it in the game." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Classes="accent"
                            Command="{Binding AddCustomTuningsCommand}"
                            Content="Add to game" />
                    </Grid>

                    <!-- The capped star column shrinks the name fields on narrow windows; on wide ones the
                         spare width collects at the right edge instead of stretching the text boxes. -->
                    <Grid RowDefinitions="*,Auto" ColumnSpacing="28" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.RowSpan="2" Grid.Column="0" Spacing="6">
                            <TextBlock Classes="fieldlabel" FontWeight="SemiBold" Text="Tuning" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Choose a tuning"
                                AutomationProperties.Name="Tuning"
                                ItemsSource="{Binding TuningNames}"
                                SelectedItem="{Binding SelectedTuningName}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="5">
                                <TextBlock Classes="fieldlabel" Text="Display name" />
                                <TextBox Text="{Binding UiName}" Watermark="Name shown in Rocksmith" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Classes="fieldlabel" Text="Internal name" />
                                <TextBox
                                    IsReadOnly="{Binding !IsNewTuning}"
                                    Text="{Binding InternalTuningName}"
                                    Watermark="Unique internal key" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Classes="fieldlabel" Text="UI index" />
                                <NumericUpDown
                                    Width="140"
                                    HorizontalAlignment="Left"
                                    Increment="1"
                                    Minimum="-1"
                                    Maximum="100000"
                                    Value="{Binding UiIndex}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="2">
                            <Grid ColumnDefinitions="22,64,110,*" ColumnSpacing="8" Margin="0,0,0,4">
                                <TextBlock Grid.Column="1" FontSize="11" Opacity="0.65" Text="String" />
                                <TextBlock Grid.Column="2" FontSize="11" Opacity="0.65" Text="Offset" />
                                <TextBlock Grid.Column="3" FontSize="11" Opacity="0.65" Text="Note" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TuningStrings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TuningStringViewModel">
                                        <Grid ColumnDefinitions="22,64,110,*" ColumnSpacing="8" Margin="0,2">
                                            <!-- Shows the string's color only; colors are edited on the Custom Colors page. -->
                                            <Border
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                VerticalAlignment="Center"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                Background="{Binding ColorHex, Converter={x:Static converters:HexToBrushConverter.Instance}}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Label}" />
                                            <NumericUpDown
                                                Grid.Column="2"
                                                Increment="1"
                                                Minimum="-24"
                                                Maximum="24"
                                                Value="{Binding Offset}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding NoteName}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding AddTuningCommand}" Content="Add tuning" />
                            <Button Command="{Binding SaveTuningCommand}" Content="Save changes" />
                            <Button Command="{Binding RemoveTuningCommand}" Content="Remove tuning" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Songs by tuning" />
                            <TextBlock
                                Classes="hint"
                                Text="Scan your song library for arrangements in the selected tuning, and for ones Rocksmith would show as Custom Tuning." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{Binding LoadSongsCommand}"
                            Content="Load songs" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding IsLoadingSongs}">
                        <ProgressBar
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding SongLoadProgress}" />
                        <TextBlock FontSize="12" Opacity="0.7" Text="Scanning song archives..." />
                    </StackPanel>

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="18"
                        RowSpacing="6"
                        IsVisible="{Binding HasLoadedSongs}">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Songs with selected tuning" />
                            <TextBlock FontSize="11" Opacity="0.65" Text="{Binding SongListTuning}" />
                        </StackPanel>
                        <Expander
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.RowSpan="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Header="{Binding SongsWithSelectedTuningHeader}">
                            <!-- A common tuning can match hundreds of songs: the list scrolls in place, and only builds
                                 the rows in view. -->
                            <ItemsControl MaxHeight="280" ItemsSource="{Binding SongsWithSelectedTuning}">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Shows as Custom Tuning" />
                            <TextBlock
                                FontSize="11"
                                Opacity="0.65"
                                TextWrapping="Wrap"
                                Text="Pick a song to list the others in its tuning, and to copy the tuning's six offsets into the &lt;New&gt; editor." />
                        </StackPanel>
                        <ComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes="customtunings"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Choose a song"
                            AutomationProperties.Name="Song with a custom tuning"
                            ItemsSource="{Binding CustomTuningRows}"
                            SelectedItem="{Binding SelectedCustomTuningRow}">
                            <ComboBox.DataTemplates>
                                <DataTemplate DataType="vm:CustomTuningHeaderRow">
                                    <TextBlock
                                        FontSize="11" FontWeight="SemiBold"
                                        Foreground="{DynamicResource NavCaptionBrush}"
                                        Text="{Binding Text}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CustomTuningSongRow">
                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Text}" />
                                </DataTemplate>
                            </ComboBox.DataTemplates>
                        </ComboBox>
                        <Button
                            Grid.Row="2"
                            Grid.Column="1"
                            Command="{Binding LoadCustomTuningFromSongCommand}"
                            Content="Load selected into &lt;New&gt;" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" IsEnabled="{Binding !IsBusy}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Default &amp; Guitarcade tones" />
                            <TextBlock
                                Classes="hint"
                                Text="Pick a tone saved in your Rocksmith profiles and assign it to a default instrument slot or one of the ten Guitarcade games. Each assignment changes the game's files immediately." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Command="{Binding LoadProfileTonesCommand}"
                            Content="Load profile tones" />
                    </Grid>

                    <Grid ColumnDefinitions="*,360" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Classes="fieldlabel" FontWeight="SemiBold" Text="Profile tone" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                PlaceholderText="Load profile tones, then choose one"
                                AutomationProperties.Name="Profile tone"
                                ItemsSource="{Binding ProfileTones}"
                                SelectedItem="{Binding SelectedProfileTone}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <Border Classes="tile">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="Default tone" />
                                        <TextBlock Classes="hint" Text="The instrument's default tone to replace." />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding DefaultToneTargets}"
                                            SelectedItem="{Binding SelectedDefaultToneTarget}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ToneTargetOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Assign selected tone as default tone"
                                            Command="{Binding AssignDefaultToneCommand}"
                                            Content="Assign" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="tile">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="Guitarcade tone" />
                                        <TextBlock Classes="hint" Text="The Guitarcade game whose tone to replace." />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <ComboBox
                                            HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding GuitarcadeToneTargets}"
                                            SelectedItem="{Binding SelectedGuitarcadeToneTarget}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ToneTargetOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Assign selected tone as Guitarcade tone"
                                            Command="{Binding AssignGuitarcadeToneCommand}"
                                            Content="Assign" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

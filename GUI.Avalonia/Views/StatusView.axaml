<UserControl
    x:Class="RSMods.Views.StatusView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    x:DataType="vm:StatusViewModel">

    <ScrollViewer>
        <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Home" />
            <TextBlock
                Classes="pageintro"
                Text="Where the configurator found Rocksmith and your save data. If Profile Edits is disabled, set your save folder here." />
            <TextBlock FontSize="15" TextWrapping="Wrap" Text="{Binding StatusMessage}" />

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Resolved locations" />
                    <TextBlock Text="{Binding RocksmithFolder, StringFormat='Rocksmith: {0}', TargetNullValue='Rocksmith: resolving…'}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SavePathDisplay, StringFormat='Save folder: {0}'}" TextWrapping="Wrap" />
                    <TextBlock Opacity="0.7" Text="{Binding CoreAssembly, StringFormat='Core assembly: {0}'}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding SetSavePathCommand}" Content="Set save folder" />
            </StackPanel>

            <!-- What's new: the latest published GitHub release. -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="What's new" />
                            <!-- Update badge: only when the published release is newer than this build. -->
                            <Border
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="6" Padding="8,2"
                                IsVisible="{Binding UpdateAvailable}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Update available" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                IsVisible="{Binding IsUpToDate}"
                                Text="{Binding CurrentVersion, StringFormat='You’re on the latest version ({0})'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Classes="accent"
                                Command="{Binding OpenReleaseCommand}"
                                Content="Download update"
                                IsVisible="{Binding UpdateAvailable}" />
                            <Button
                                Command="{Binding OpenReleaseCommand}"
                                Content="View on GitHub"
                                IsVisible="{Binding IsUpToDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- Loading -->
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoadingRelease}">
                        <ProgressBar Width="120" IsIndeterminate="True" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="Loading the latest release…" />
                    </StackPanel>

                    <!-- Error / retry -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasReleaseError}">
                        <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding ReleaseError}" />
                        <Button HorizontalAlignment="Left" Command="{Binding LoadLatestReleaseCommand}" Content="Retry" />
                    </StackPanel>

                    <!-- Release notes -->
                    <StackPanel Spacing="8" IsVisible="{Binding HasRelease}">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ReleaseTitle}" />
                        <TextBlock
                            Opacity="0.6" FontSize="12"
                            IsVisible="{Binding ReleasePublished, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding ReleasePublished, StringFormat='Released {0}'}" />
                        <!-- Caps tall changelogs and scrolls them internally rather than stretching the page. -->
                        <md:MarkdownScrollViewer
                            MaxHeight="520"
                            Markdown="{Binding ReleaseNotes}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

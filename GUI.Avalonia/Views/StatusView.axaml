<UserControl
    x:Class="RSMods.Views.StatusView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    x:DataType="vm:StatusViewModel">

    <!-- The page doesn't scroll: the release notes fill what's left and scroll on their own, so there is never a
         scrolling area inside another. -->
    <Grid Margin="32,28" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
            <TextBlock Classes="h1" Text="Home" />
            <TextBlock Grid.Row="1" FontSize="15" TextWrapping="Wrap" Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Grid.Row="2" Classes="card">
                <StackPanel Spacing="12">
                    <Grid Classes="action" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="actionname" Text="Rocksmith folder" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding RocksmithFolder, TargetNullValue='Resolving…'}" />
                        </StackPanel>
                        <Button
                            AutomationProperties.Name="Set Rocksmith folder"
                            Command="{Binding SetRocksmithFolderCommand}"
                            Content="Change…" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="action" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="actionname" Text="Save folder" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding SavePathDisplay}" />
                        </StackPanel>
                        <Button
                            AutomationProperties.Name="Set save folder"
                            Command="{Binding SetSavePathCommand}"
                            Content="Change…" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What's new: the latest published GitHub release. -->
            <Border Grid.Row="3" Classes="card">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="What's new" />
                            <!-- Update badge: only when the published release is newer than this build. -->
                            <Border
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="6" Padding="8,2"
                                IsVisible="{Binding UpdateAvailable}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="Update available" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                IsVisible="{Binding IsUpToDate}"
                                Text="{Binding CurrentVersion, StringFormat='You’re on the latest version ({0})'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Classes="accent"
                                Command="{Binding OpenReleaseCommand}"
                                Content="Download update"
                                IsVisible="{Binding UpdateAvailable}" />
                            <Button
                                Command="{Binding OpenReleaseCommand}"
                                Content="View on GitHub"
                                IsVisible="{Binding IsUpToDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- Loading -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsLoadingRelease}">
                        <ProgressBar Width="120" IsIndeterminate="True" />
                        <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="Loading the latest release…" />
                    </StackPanel>

                    <!-- Error / retry -->
                    <StackPanel Grid.Row="2" Spacing="10" IsVisible="{Binding HasReleaseError}">
                        <TextBlock Opacity="0.8" TextWrapping="Wrap" Text="{Binding ReleaseError}" />
                        <Button HorizontalAlignment="Left" Command="{Binding LoadLatestReleaseCommand}" Content="Retry" />
                    </StackPanel>

                    <!-- Release notes -->
                    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="{Binding HasRelease}">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding ReleaseTitle}" />
                        <TextBlock
                            Grid.Row="1"
                            Opacity="0.6" FontSize="12"
                            IsVisible="{Binding ReleasePublished, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Text="{Binding ReleasePublished, StringFormat='Released {0}'}" />
                        <md:MarkdownScrollViewer Grid.Row="2" Markdown="{Binding ReleaseNotes}" />
                    </Grid>
                </Grid>
            </Border>
    </Grid>
</UserControl>

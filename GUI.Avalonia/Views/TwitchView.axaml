<UserControl
    x:Class="RSMods.Views.TwitchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:twitch="clr-namespace:RSMods.Twitch;assembly=GUI.Core"
    xmlns:conv="clr-namespace:RSMods.Converters"
    xmlns:views="clr-namespace:RSMods.Views"
    x:DataType="vm:TwitchViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.statuslabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TextBlock.statusvalue">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Styles>

    <!-- The page doesn't scroll. The rules and the log are tabs that fill the rest of the height, each its own
         single scrolling list, so there is never a scrolling list inside another. -->
    <Grid Margin="32,28" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,*" RowSpacing="18">
            <TextBlock Classes="h1" Text="Twitch" />

            <!-- Connection: the three states at a glance, then who is authorized and the controls. -->
            <Border Grid.Row="1" Classes="card">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Classes="statuslabel" Text="TWITCH ACCOUNT" />
                            <TextBlock Classes="statusvalue" Text="{Binding AuthenticationStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Classes="statuslabel" Text="EVENTSUB" />
                            <TextBlock Classes="statusvalue" Text="{Binding EventSubStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3">
                            <TextBlock Classes="statuslabel" Text="ROCKSMITH" />
                            <TextBlock Classes="statusvalue" Text="{Binding RocksmithStatus}" />
                        </StackPanel>
                    </Grid>

                    <Border Classes="divider" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock IsVisible="{Binding HasIdentity}" TextWrapping="Wrap">
                                <Run Text="Authorized as " />
                                <Run FontWeight="SemiBold" Text="{Binding Username}" />
                                <Run Text="  ·  Channel ID: " />
                                <Run Text="{Binding ChannelId}" />
                            </TextBlock>
                            <TextBlock Classes="hint" Text="{Binding StatusDetail}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding AuthorizeCommand}" Content="{Binding AuthorizeButtonText}" />
                            <Button Command="{Binding CancelAuthorizationCommand}" Content="Cancel" IsVisible="{Binding IsAuthorizing}" AutomationProperties.Name="Cancel authorization" />
                            <Button Command="{Binding ForgetAuthorizationCommand}" Content="Forget" AutomationProperties.Name="Forget authorization" />
                            <Button Command="{Binding StartListeningCommand}" Content="Start listening" />
                            <Button Command="{Binding StopListeningCommand}" Content="Stop" AutomationProperties.Name="Stop listening" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="14" Background="{DynamicResource ShellHeaderBrush}" CornerRadius="6" IsVisible="{Binding IsAuthorizing}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Complete authorization in your browser" />
                                <TextBlock Classes="hint" Text="Enter this code on Twitch. RSMods continues automatically when authorization finishes." />
                                <TextBlock Opacity="0.8" Text="{Binding VerificationUri}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Consolas" FontSize="26" FontWeight="Bold" Text="{Binding UserCode}" />
                                <Button Classes="accent" Command="{Binding OpenVerificationPageCommand}" Content="Open verification page" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="2" Padding="0,10,0,0">
            <TabItem Header="Reward rules">
            <!-- Reward rules: pick from the catalog on the left, edit what's enabled on the right. -->
            <!-- The catalog gives way first on narrow windows; the rules grid scrolls sideways once Effect hits its minimum. -->
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="250" MaxWidth="320" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Add a rule" />
                            <TextBlock Classes="hint" Text="Pick an effect and what triggers it, then add it as a rule." />
                        </StackPanel>
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Choose an effect"
                            AutomationProperties.Name="Effect"
                            ItemsSource="{Binding CatalogEffects}"
                            SelectedItem="{Binding SelectedCatalogEffect}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="twitch:TwitchReward">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Classes="hint"
                            IsVisible="{Binding SelectedCatalogEffect, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Text="{Binding SelectedCatalogEffect.Description, FallbackValue=''}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding TriggerChoices}"
                                SelectedItem="{Binding SelectedTriggerChoice}" />
                            <Button Grid.Column="1" Classes="accent" Command="{Binding AddRuleCommand}" Content="Add" AutomationProperties.Name="Add selected effect" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card">
                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Enabled rules" />
                            <TextBlock Classes="hint" Text="Save updates the running listener and the shared TwitchEnabledEffects.xml." />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="1"
                            MinHeight="120"
                            AutoGenerateColumns="False"
                            GridLinesVisibility="All"
                            ItemsSource="{Binding RewardRules}"
                            SelectedItem="{Binding SelectedRule}">
                            <DataGrid.Columns>
                                <!-- A real checkbox in every row: the grid's checkbox column only makes the selected row's live,
                                     drawing the rest greyed out and needing a click to select the row before one to toggle. -->
                                <DataGridTemplateColumn Header="On" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TwitchRewardRuleViewModel">
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="{Binding Name, StringFormat='{}{0} on'}"
                                                IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Effect" Binding="{Binding Name}" IsReadOnly="True" Width="*" MinWidth="150" />
                                <DataGridTextColumn Header="Seconds" Binding="{Binding DurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                <DataGridTextColumn Header="Trigger" Binding="{Binding TriggerLabel}" IsReadOnly="True" Width="120" />
                                <DataGridTemplateColumn Header="Amount" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TwitchRewardRuleViewModel">
                                            <Grid>
                                                <TextBox
                                                    IsVisible="{Binding UsesAmount}"
                                                    Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !UsesAmount}"
                                                    Text="—" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding LocalId}" IsReadOnly="True" Width="56" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- FallbackValue: with no rule selected the path doesn't resolve, which would leave the panel visible. -->
                        <Border
                            Grid.Row="2"
                            Padding="12"
                            Background="{DynamicResource ShellHeaderBrush}"
                            CornerRadius="6"
                            IsVisible="{Binding SelectedRule.IsSolidNotes, FallbackValue=False}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Solid Color Notes color" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <CheckBox Content="Random" IsChecked="{Binding SelectedRule.RandomColor}" />
                                    <TextBox
                                        Width="110"
                                        MaxLength="6"
                                        Watermark="RRGGBB"
                                        IsEnabled="{Binding !SelectedRule.RandomColor}"
                                        Text="{Binding SelectedRule.HexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <views:ColorSwatchButton
                                        Width="28"
                                        Height="28"
                                        AutomationProperties.Name="Pick the note color"
                                        IsEnabled="{Binding !SelectedRule.RandomColor}"
                                        Hex="{Binding SelectedRule.HexColor}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="3"
                            Foreground="#E06C75"
                            Text="{Binding SelectedRule.ValidationMessage}"
                            TextWrapping="Wrap" />

                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="{Binding RulesStatus}" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding RemoveRuleCommand}" Content="Remove" />
                                <Button Command="{Binding TestRuleCommand}" Content="Test reward" />
                                <Button Command="{Binding RevertRulesCommand}" Content="Revert" />
                                <Button Classes="accent" Command="{Binding SaveRulesCommand}" Content="Save" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            </TabItem>

            <TabItem Header="Runtime log">
            <Border Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock VerticalAlignment="Center" Classes="hint" Text="What the listener and the Rocksmith connection did, newest last." />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding ClearLogCommand}" Content="Clear" AutomationProperties.Name="Clear log" />
                            <Button Command="{Binding SaveLogCommand}" Content="Save log…" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}" SelectedItem="{Binding SelectedLogEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="twitch:TwitchLogEntry">
                                <Grid ColumnDefinitions="80,*" Margin="0,2">
                                    <TextBlock Opacity="0.65" Text="{Binding LocalTimestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            </TabItem>
            </TabControl>
    </Grid>
</UserControl>

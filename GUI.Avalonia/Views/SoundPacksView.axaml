<UserControl
    x:Class="RSMods.Views.SoundPacksView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:core="clr-namespace:RSMods.Core;assembly=GUI.Core"
    x:DataType="vm:SoundPacksViewModel">

    <ScrollViewer>
        <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="SoundPacks" />
            <TextBlock
                Classes="pageintro"
                Text="Replace Rocksmith's result-screen voice lines with your own audio. Unpack the game's audio archive, swap any of the result lines (MP3, OGG, WAV or WEM), then repack. You can also import or export a whole sound pack to share with friends." />

            <!-- Busy status -->
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
                <ProgressBar Width="120" IsIndeterminate="True" />
                <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding StatusMessage}" />
            </StackPanel>

            <!-- Determinate pack/unpack progress -->
            <StackPanel Spacing="6" IsVisible="{Binding IsPacking}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
                <TextBlock FontSize="12" Opacity="0.7" Text="{Binding ProgressOperation}" />
            </StackPanel>

            <!-- The sidebar takes up to 380 px and gives way first on narrow windows, down to what its action rows
                 need; the voice lines keep enough width for their longest name. -->
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="390" />
                    <ColumnDefinition Width="*" MinWidth="260" MaxWidth="380" />
                </Grid.ColumnDefinitions>
                <!-- Main column: the unpack prompt until audio.psarc is unpacked, then the voice lines. -->
                <StackPanel Grid.Column="0" Spacing="18">
                    <Border Classes="card" IsVisible="{Binding ShowUnpackPrompt}">
                        <Grid Classes="action" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Unpack audio.psarc" />
                                <TextBlock
                                    Classes="hint"
                                    Text="To edit sound packs, the game's audio archive has to be unpacked. This uses roughly 1.3 GB of disk space and can take a little while." />
                            </StackPanel>
                            <Button
                                Classes="accent"
                                AutomationProperties.Name="Unpack audio.psarc"
                                Command="{Binding UnpackCommand}"
                                Content="Unpack" />
                        </Grid>
                    </Border>

                    <Border Classes="card" IsVisible="{Binding IsUnpacked}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Result voice lines" />
                                <TextBlock
                                    Classes="hint"
                                    Text="Replace the line played for a score with your own audio. WAV and OGG need Wwise installed to convert. Repack when you're done." />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" FontSize="11" Opacity="0.65" Text="Score" />
                                    <TextBlock Grid.Column="1" FontSize="11" Opacity="0.65" Text="Voice line" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding VoiceLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="core:SoundPackVoiceLine">
                                            <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12" Margin="0,2">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding ScoreRange}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Name}" />
                                                <Button
                                                    Grid.Column="2"
                                                    Padding="10,3"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Replace {0}'}"
                                                    Command="{Binding $parent[ItemsControl].((vm:SoundPacksViewModel)DataContext).ReplaceVoiceLineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Replace…" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sidebar: applying and sharing the pack, previewing it, and the tools it depends on. -->
                <StackPanel Grid.Column="1" Spacing="18">
                    <Border Classes="card" IsVisible="{Binding IsUnpacked}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Apply &amp; manage" />
                                <TextBlock
                                    Classes="hint"
                                    Text="Replacing, importing and resetting change the unpacked files only. The game hears them after a repack." />
                            </StackPanel>

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Repack audio.psarc" />
                                    <TextBlock Classes="hint" Text="Writes your voice lines into the game. Takes a few minutes." />
                                </StackPanel>
                                <Button
                                    Classes="accent"
                                    AutomationProperties.Name="Repack audio.psarc"
                                    Command="{Binding RepackCommand}"
                                    Content="Repack" />
                            </Grid>
                            <Border Classes="divider" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Import soundpack" />
                                    <TextBlock Classes="hint" Text="Loads a shared .rs_soundpack." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Import soundpack"
                                    Command="{Binding ImportCommand}"
                                    Content="Import…" />
                            </Grid>
                            <Border Classes="divider" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Export soundpack" />
                                    <TextBlock Classes="hint" Text="Saves the current lines as a .rs_soundpack to share." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Export soundpack"
                                    Command="{Binding ExportCommand}"
                                    Content="Export…" />
                            </Grid>
                            <Border Classes="divider" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Reset to stock" />
                                    <TextBlock Classes="hint" Text="Puts the original voice lines back." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Reset to stock"
                                    Command="{Binding ResetCommand}"
                                    Content="Reset" />
                            </Grid>
                            <Border Classes="divider" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Remove unpacked" />
                                    <TextBlock Classes="hint" Text="Frees about 1.3 GB. Repack first, or your changes are lost." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Remove unpacked"
                                    Command="{Binding RemoveUnpackedCommand}"
                                    Content="Remove" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Preview in-game" />
                                <TextBlock
                                    Classes="hint"
                                    Text="With Rocksmith running, play a result voice-over to hear it in the game." />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="Choose a voice-over"
                                    ItemsSource="{Binding ResultVoiceOvers}"
                                    SelectedItem="{Binding SelectedResultVo}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Play selected voice-over"
                                    Command="{Binding PlayResultVoiceOverCommand}"
                                    Content="Play" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Tools" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Wwise" />
                                    <TextBlock Classes="hint" Text="Converts WAV and OGG files to the game's audio format." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Download Wwise"
                                    Command="{Binding DownloadWwiseCommand}"
                                    Content="Download" />
                            </Grid>
                            <Border Classes="divider" />

                            <Grid Classes="action" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="actionname" Text="Found a problem?" />
                                    <TextBlock Classes="hint" Text="Report it on GitHub." />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="Report a bug"
                                    Command="{Binding ReportBugCommand}"
                                    Content="Report" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="RSMods.Views.RocksmithSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    x:DataType="vm:RocksmithSettingsViewModel">

    <ScrollViewer>
        <StackPanel Classes="page">
            <TextBlock Classes="h1" Text="Rocksmith settings" />
            <TextBlock
                Classes="pageintro"
                Text="Rocksmith.ini — the game's own audio and renderer configuration. Saving preserves comments and any entries not shown here." />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="accent" Command="{Binding SaveCommand}" Content="Save" />
                <Button Command="{Binding RevertCommand}" Content="Revert" />
                <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding StatusMessage}" />
            </StackPanel>

            <!-- Cards flow into as many columns as the window width allows. -->
            <WrapPanel Orientation="Horizontal">
            <!-- Audio -->
            <Border Classes="card" Width="560" Margin="0,0,18,18" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Audio" />
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Width="260" Content="Enable microphone" IsChecked="{Binding EnableMicrophone}" />
                        <CheckBox Width="250" Content="Exclusive mode" IsChecked="{Binding ExclusiveMode}" />
                        <CheckBox Width="260" Content="Force WDM" IsChecked="{Binding ForceWdm}" />
                        <CheckBox Width="250" Content="Force DirectX sink" IsChecked="{Binding ForceDirectXSink}" />
                        <CheckBox Width="260" Content="Real Tone cable only" IsChecked="{Binding RealToneCableOnly}" />
                        <CheckBox Width="250" Content="Win32 ultra-low-latency mode" IsChecked="{Binding Win32UltraLowLatencyMode}" />
                        <CheckBox Width="260" Content="Dump audio log" IsChecked="{Binding DumpAudioLog}" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Latency buffer" />
                        <NumericUpDown
                            Grid.Row="0" Grid.Column="1"
                            MinWidth="200" HorizontalAlignment="Left"
                            Increment="1"
                            Minimum="{Binding LatencyBufferMin}"
                            Maximum="{Binding LatencyBufferMax}"
                            Value="{Binding LatencyBuffer}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Max output buffer size" />
                        <NumericUpDown
                            Grid.Row="1" Grid.Column="1"
                            Margin="0,10,0,0"
                            MinWidth="200" HorizontalAlignment="Left"
                            Increment="1" Minimum="0"
                            Value="{Binding MaxOutputBufferSize}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Force playback device" />
                        <TextBox
                            Grid.Row="2" Grid.Column="1"
                            Margin="0,10,0,0"
                            MinWidth="200" HorizontalAlignment="Left"
                            Watermark="(system default)"
                            Text="{Binding ForceDefaultPlaybackDevice}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Renderer -->
            <Border Classes="card" Width="560" Margin="0,0,18,18" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="Renderer" />
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Width="260" Content="Show gamepad UI" IsChecked="{Binding ShowGamepadUi}" />
                        <CheckBox Width="250" Content="Enable post effects" IsChecked="{Binding EnablePostEffects}" />
                        <CheckBox Width="260" Content="Enable shadows" IsChecked="{Binding EnableShadows}" />
                        <CheckBox Width="250" Content="Enable high-res scope" IsChecked="{Binding EnableHighResScope}" />
                        <CheckBox Width="260" Content="Enable depth of field" IsChecked="{Binding EnableDepthOfField}" />
                        <CheckBox Width="250" Content="Enable per-pixel lighting" IsChecked="{Binding EnablePerPixelLighting}" />
                        <CheckBox Width="260" Content="Disable browser" IsChecked="{Binding DisableBrowser}" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,6,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Fullscreen" />
                        <ComboBox
                            Grid.Row="0" Grid.Column="1"
                            MinWidth="200"
                            ItemsSource="{Binding FullscreenModes}"
                            SelectedItem="{Binding Fullscreen}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Visual quality" />
                        <ComboBox
                            Grid.Row="1" Grid.Column="1"
                            Margin="0,10,0,0"
                            MinWidth="200"
                            ItemsSource="{Binding VisualQualityModes}"
                            SelectedItem="{Binding VisualQuality}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="MSAA samples" />
                        <ComboBox
                            Grid.Row="2" Grid.Column="1"
                            Margin="0,10,0,0"
                            MinWidth="200"
                            ItemsSource="{Binding MsaaModes}"
                            SelectedItem="{Binding MsaaSamples}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Screen width × height" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Width="130" Increment="1" Minimum="0" Value="{Binding ScreenWidth}" />
                            <NumericUpDown Width="130" Increment="1" Minimum="0" Value="{Binding ScreenHeight}" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,10,0,0" VerticalAlignment="Center" Text="Rendering width × height" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                            <NumericUpDown Width="130" Increment="1" Minimum="0" Value="{Binding RenderingWidth}" />
                            <NumericUpDown Width="130" Increment="1" Minimum="0" Value="{Binding RenderingHeight}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Net -->
            <Border Classes="card" Width="360" Margin="0,0,18,18" VerticalAlignment="Top">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Net" />
                    <CheckBox Content="Use proxy" IsChecked="{Binding UseProxy}" />
                </StackPanel>
            </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

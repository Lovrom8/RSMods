<UserControl
    x:Class="RSMods.Views.ColorsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RSMods.ViewModels"
    xmlns:conv="clr-namespace:RSMods.Converters"
    xmlns:views="clr-namespace:RSMods.Views"
    x:DataType="vm:ColorsViewModel">

    <UserControl.Styles>
        <!-- Three cards per row, fewer on narrow windows. -->
        <Style Selector="WrapPanel#Columns > :is(Control)">
            <Setter Property="Width" Value="{Binding $parent[WrapPanel].Bounds.Width, Converter={x:Static conv:ColumnWidthConverter.Instance}, ConverterParameter=330}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="WrapPanel#Columns Border.card">
            <Setter Property="Margin" Value="0,0,18,18" />
        </Style>
        <!-- A hex field with its color inside it; clicking the color opens a color wheel. -->
        <Style Selector="TextBox.hex">
            <Setter Property="Width" Value="100" />
            <Setter Property="Watermark" Value="RRGGBB" />
        </Style>
        <Style Selector="Button.preview">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="7,0,0,0" />
        </Style>
        <Style Selector="TextBlock.columnhead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- A string's color in the normal and colorblind palettes. -->
        <DataTemplate x:Key="PairRow" x:DataType="vm:ColorPairRow">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                <TextBox
                    Grid.Column="1" Classes="hex"
                    AutomationProperties.Name="{Binding Label, StringFormat='{}{0} color'}"
                    Text="{Binding Normal.Hex}">
                    <TextBox.InnerLeftContent>
                        <views:ColorSwatchButton Classes="preview" AutomationProperties.Name="{Binding Label, StringFormat='Pick {0} color'}" Hex="{Binding Normal.Hex}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBox
                    Grid.Column="2" Classes="hex"
                    AutomationProperties.Name="{Binding Label, StringFormat='{}{0} colorblind color'}"
                    Text="{Binding Colorblind.Hex}">
                    <TextBox.InnerLeftContent>
                        <views:ColorSwatchButton Classes="preview" AutomationProperties.Name="{Binding Label, StringFormat='Pick {0} colorblind color'}" Hex="{Binding Colorblind.Hex}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SingleRow" x:DataType="vm:ColorSwatchViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Label}" />
                <TextBox
                    Grid.Column="1" Classes="hex"
                    AutomationProperties.Name="{Binding Label, StringFormat='{}{0} color'}"
                    Text="{Binding Hex}">
                    <TextBox.InnerLeftContent>
                        <views:ColorSwatchButton Classes="preview" AutomationProperties.Name="{Binding Label, StringFormat='Pick {0} color'}" Hex="{Binding Hex}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource PageOuterMaxWidth}" />
            </Grid.ColumnDefinitions>
        <StackPanel Classes="page" HorizontalAlignment="Stretch">
            <!-- The save status sits beside the title, so it appearing doesn't push the page down. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="h1" Text="Custom Colors" />
                <TextBlock
                    Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,18,0"
                    FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                    Text="{Binding StatusMessage}" />
            </Grid>

            <WrapPanel x:Name="Columns" Orientation="Horizontal">
                <!-- String colors -->
                <StackPanel>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="String colors" />
                                    <TextBlock Classes="hint" Text="Your own color for each string." />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1" VerticalAlignment="Top"
                                    AutomationProperties.Name="Use custom string colors"
                                    Content="Enabled"
                                    IsChecked="{Binding UseCustomStringColors}" />
                            </Grid>

                            <StackPanel IsEnabled="{Binding CanEditStringColors}">
                                <Grid ColumnDefinitions="*,100,100" ColumnSpacing="8" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="1" Classes="columnhead" Text="Normal" />
                                    <TextBlock Grid.Column="2" Classes="columnhead" Text="Colorblind" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding StringColorRows}" ItemTemplate="{StaticResource PairRow}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Note colors -->
                <StackPanel>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Note colors" />
                                    <TextBlock Classes="hint" Text="Color notes separately from their strings." />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1" VerticalAlignment="Top"
                                    AutomationProperties.Name="Use separate note colors"
                                    Content="Enabled"
                                    IsChecked="{Binding UseSeparateNoteColors}" />
                            </Grid>

                            <StackPanel Spacing="12" IsEnabled="{Binding CanEditNoteColors}">
                                <CheckBox AutomationProperties.Name="Use Rocksmith's note colors" IsChecked="{Binding UseRocksmithNoteColors}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Use Rocksmith's note colors" />
                                        <TextBlock Classes="hint" Text="The game's normal note colors instead of your own." />
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel IsEnabled="{Binding CanEditNoteSwatches}">
                                    <Grid ColumnDefinitions="*,100,100" ColumnSpacing="8" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="1" Classes="columnhead" Text="Normal" />
                                        <TextBlock Grid.Column="2" Classes="columnhead" Text="Colorblind" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding NoteColorRows}" ItemTemplate="{StaticResource PairRow}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Highway colors -->
                <StackPanel>
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Highway colors" />
                                    <TextBlock Classes="hint" Text="Base colors only: Rocksmith tints them, so aim a little lighter." />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1" VerticalAlignment="Top"
                                    AutomationProperties.Name="Use custom highway colors"
                                    Content="Enabled"
                                    IsChecked="{Binding UseCustomHighwayColors}" />
                            </Grid>

                            <ItemsControl
                                IsEnabled="{Binding CanEditHighwayColors}"
                                ItemsSource="{Binding HighwaySwatches}"
                                ItemTemplate="{StaticResource SingleRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

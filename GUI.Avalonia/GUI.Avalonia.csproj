<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RsModsMac)' == 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget Condition="'$(RsModsMac)' != 'true'">x64</PlatformTarget>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>RSMods</RootNamespace>
    <!-- Ships as RSMods.exe, preserving the installed <Rocksmith>/RSMods/RSMods.exe path and shortcuts. -->
    <AssemblyName>RSMods</AssemblyName>
    <!-- Win32 executable icon for the published RSMods.exe. Owned here now that the icon
         no longer lives under GUI/Assets. -->
    <ApplicationIcon>Assets\LogoX256.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.12" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Renders the GitHub release notes (Markdown) on the Home tab. -->
    <PackageReference Include="Markdown.Avalonia" Version="11.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GUI.Core\GUI.Core.csproj" />
  </ItemGroup>

  <!--
    The shared Core's SoundPack work loads SevenZipSharp's 7z64.dll by path relative to the app base. Ship
    the whole RuntimeAssets/ tree beside the executable, preserving its relative layout via Link. Both build
    output and publish output are covered, which is what the win-x64 publish pipeline relies on.
  -->
  <!--
    Managed assemblies that GUI.Core already owns (its SevenZipSharp/etc. references and their resolved
    dependencies) arrive beside RSMods.exe through the project reference. Excluding them here keeps a single
    owner per file; otherwise publish rejects the duplicate relative paths (NETSDK1152). Everything else in
    RuntimeAssets - the 7z natives and the remaining legacy libs - is owned and shipped from here.
  -->
  <ItemGroup>
    <Content Include="..\RuntimeAssets\**\*.*" Exclude="..\RuntimeAssets\MiscUtil.dll;&#xD;&#xA;                      ..\RuntimeAssets\SevenZipSharp.dll;&#xD;&#xA;                      ..\RuntimeAssets\zlib.net.dll">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

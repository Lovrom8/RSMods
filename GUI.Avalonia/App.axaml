<Application
    x:Class="RSMods.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <!-- Shell + surface brushes that track the theme variant so chrome, panels and dividers
             stay legible in both light and dark. Accent shades come from FluentTheme's
             SystemAccentColor* resources (themeable via ThemeService), so anything that binds them
             follows the user's chosen accent automatically. -->
        <ResourceDictionary>
            <!-- Brush wrappers over FluentTheme's accent Colors. SystemAccentColor* are Colors, not
                 Brushes, so binding them straight into Background/Foreground would silently no-op.
                 DynamicResource on .Color keeps these tracking the user's chosen accent (ThemeService). -->
            <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush x:Key="AccentBrushLight1" Color="{DynamicResource SystemAccentColorLight1}" />
            <SolidColorBrush x:Key="AccentBrushDark1" Color="{DynamicResource SystemAccentColorDark1}" />

            <!-- Shared page-shell metrics so every tab lines up. PageMaxWidth caps content on wide
                 windows (cards reflow within it); PageProseMaxWidth keeps help text at a readable
                 line length. Change here, not per view. -->
            <x:Double x:Key="PageMaxWidth">1200</x:Double>
            <!-- PageMaxWidth plus the page's 32 px side margins: caps a full-width page wrapper at the same edge. -->
            <x:Double x:Key="PageOuterMaxWidth">1264</x:Double>
            <x:Double x:Key="PageProseMaxWidth">820</x:Double>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellHeaderBrush" Color="#1C1F25" />
                    <SolidColorBrush x:Key="ShellNavBrush" Color="#16181D" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#22262D" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2F37" />
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#31373F" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3A414B" />
                    <SolidColorBrush x:Key="SubtleFillBrush" Color="#15181C" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#252A31" />
                    <SolidColorBrush x:Key="NavCaptionBrush" Color="#7C838D" />
                    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#3A2F14" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#C7952B" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5DFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellHeaderBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="ShellNavBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F3F5" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#DDE1E6" />
                    <SolidColorBrush x:Key="SubtleFillBrush" Color="#EDEFF2" />
                    <SolidColorBrush x:Key="NavHoverBrush" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="NavCaptionBrush" Color="#8A9099" />
                    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D9A400" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- ============================ Typography ============================ -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.h3">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- ============================ Page shell ============================ -->
        <!-- The root content stack of every tab. One margin, one spacing, one max-width so tabs
             stop drifting and the layout stays put when you switch between them. Content is
             left-anchored under the nav and reflows/caps within PageMaxWidth. -->
        <Style Selector="StackPanel.page">
            <Setter Property="Margin" Value="32,28" />
            <Setter Property="Spacing" Value="18" />
            <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- ============================ Cards ============================ -->
        <!-- A raised surface panel. Replaces the flat hairline-bordered borders so panels
             lift off the page instead of stacking as identical rectangles. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="0 2 10 0 #22000000" />
        </Style>

        <!-- A page-level warning: something outside the app needs fixing before the page's settings work. -->
        <Style Selector="Border.warning">
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <!-- Flyouts whose content brings its own margins, like the color wheel. -->
        <Style Selector="FlyoutPresenter.nopadding">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- A small inset "stat" tile: heavier fill, used for at-a-glance status chips. -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- ============================ Card content ============================ -->
        <!-- One row per setting or action: name and a one-line hint on the left, its control on the right. -->
        <Style Selector="Grid.action">
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style Selector="Grid.action > Button">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.action > StackPanel.buttons">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.actionname">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Settings that are switched off stay on screen, greyed out. Fluent greys the controls; this greys the
             labels beside them to match, so the page doesn't change shape when a switch is flipped. -->
        <Style Selector="TextBlock[IsEffectivelyEnabled=False]">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}" />
        </Style>
        <!-- A setting row: label and hint on the left, its input at a fixed width on the right (ColumnDefinitions="*,Auto"). -->
        <Style Selector="Grid.field">
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <Style Selector="Grid.field > StackPanel">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.field > NumericUpDown, Grid.field > ComboBox, Grid.field > TextBox">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============================ Sidebar nav ============================ -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
        </Style>
        <!-- Active item: accent wash + accent text so the current section reads at a glance. -->
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushLight1}" />
        </Style>

        <!-- ============================ Accent buttons ============================ -->
        <!-- Primary action (Save, connect, etc.): filled with the accent. -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushLight1}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushDark1}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
    </Application.Styles>
</Application>

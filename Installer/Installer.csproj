<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>RS2014_Mod_Installer</RootNamespace>
    <AssemblyName>RS2014-Mod-Installer</AssemblyName>
    <ApplicationIcon>Assets\LogoX256.ico</ApplicationIcon>
    <Version>1.2.8.4</Version>
    <Product>Rocksmith2014-Mod-Installer</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Installer.Core\Installer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon sets the Win32 executable icon; AvaloniaResource makes the same file available
         to MainWindow's /Assets/LogoX256.ico URI at runtime. -->
    <AvaloniaResource Include="Assets\LogoX256.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\xinput1_3.dll" LogicalName="xinput1_3.dll" />
    <EmbeddedResource Include="Resources\xinput1_3.pdb" LogicalName="xinput1_3.pdb" />
    <EmbeddedResource Include="..\Build\Artifacts\installer\RSModsGUI.zip" LogicalName="RSModsGUI.zip" />
    <EmbeddedResource Include="..\Build\Artifacts\installer\RSModsGUI.manifest.json" LogicalName="RSModsGUI.manifest.json" />
  </ItemGroup>

  <Target Name="EnsureInstallerInputs" BeforeTargets="PrepareForBuild;CoreCompile">
    <Error Condition="!Exists('Resources\xinput1_3.dll') Or !Exists('Resources\xinput1_3.pdb')"
           Text="Native mod outputs are missing. Build DLL/DLL.vcxproj (Release|Win32) before publishing the installer." />
    <Error Condition="!Exists('..\Build\Artifacts\installer\RSModsGUI.zip') Or !Exists('..\Build\Artifacts\installer\RSModsGUI.manifest.json')"
           Text="Configurator payload not found. Run Build/Publish-Configurator.ps1 and Build/New-ConfiguratorPayload.ps1 before publishing the installer." />
  </Target>

</Project>
